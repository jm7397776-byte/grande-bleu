{
  "name": "grande-bleu",
  "version": "1.0.0",
  "description": "Grande Bleu project",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js'",
    "start": "node src/web/server.js"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-plugin-jest": "^28.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "src/api/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "dotenv": "^17.4.0"
  }
}
